														"maxclass" : "codebox",
														"outlettype" : [ "", "", "", "", "", "", "", "" ],
														"fontface" : 0,
														"id" : "obj-3",
														"patching_rect" : [ 40.0, 40.0, 545.0, 350.0 ],
														"numinlets" : 2,
														"fontsize" : 10.0,
														"numoutlets" : 8,
														"fontname" : "<Monospaced>",
														"code" : "Buffer lows(\"lows\");\r\nParam bar(3000);\r\nHistory rating(-96);\r\nHistory span_low(999999);\r\nHistory prior_low(999999);\r\nHistory prior_rating(999999);\r\nHistory bars(0);\r\nHistory start(0);\r\nout7 = 0;\r\nout8 = 0;\r\nscore = in1;\r\n//rating is calculated up to this point (regardless of whether it will continue)\r\nspan_low = min(span_low, score);\r\nbars += 1;\r\nwould_be_rating = span_low * bars;    //would-be rating\r\nif(rating > would_be_rating) {   //old span is better off without new bar attached\r\n    bars = 1;    //end span and reset everything\r\n    span_low = score;\r\n    out7 = 1;\r\n    start = in2;\r\n}\r\nif(score > would_be_rating) {   //new bar is better off without old span attached\r\n    bars = 1;    //end span and reset everything\r\n    span_low = score;\r\n    out7 = 2;\r\n    start = in2;\r\n}\r\nif(abs(delta(in2)) > bar) {   //not contiguous\r\n    bars = 1;    //end span and reset everything\r\n    span_low = score;\r\n    out7 = 3;\r\n    start = in2;\r\n}\r\nrating = span_low * bars;\r\nout1 = mc_channel;\r\nout2 = in2;\r\nout3 = would_be_rating;\r\nout4 = rating;\r\nout5 = bars;\r\nout6 = span_low;\r\nout8 = start;"
													}

												}
