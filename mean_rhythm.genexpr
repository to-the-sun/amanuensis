blog(buf, value) {
	idx = counter(1, 0, dim(buf));
	poke(buf, value, idx, 0, 0, 0);
	poke(buf, elapsed, idx, 1, 0, 0);
	return value;
}

mean_rhythm(frame, excluding) {
    //require("log");

    Buffer j_rhythm("j_rhythm");
    Buffer r_rhythm("r_rhythm");
    Buffer j_max("j_max");
    Buffer r_max("r_max");
    Buffer log_r_scores("log_r_scores");
    Buffer log_j_scores("log_j_scores");
    Buffer r_checks_log("r_checks_log");
    Buffer j_checks_log("j_checks_log");
    Buffer j_scores_log("j_scores_log");
    Buffer r_scores_log("r_scores_log");
    of = 1;
    mean = 0;
    tracks = 4;
    bands = 2;
    quantity = tracks * bands * 2;
    for(track = 1; track <= tracks * bands; track += bands) {
        if(excluding != track) {
            for(band = track; band < track + bands; band += 1) {
                if(excluding) {
                    of = peek(r_max, 0, band);	// Don't normalize if it's determining the universal `mode_interval`. 
                    if(!of) {                   //Empty space on a track shouldn't count towards the average. 
                        quantity -= 1;
                    }
                }
                vibe = peek(r_rhythm, frame, band);
                if(excluding > 0) {                             //Only log for jamming so it doesn't constantly get overwritten. 
                    normalized = vibe / of;
                    poke(log_r_scores, of, 0, band);
                    //blog(r_checks_log, normalized);
                }
                mean += vibe / of;
            }
        }
    }
    for(track = 1; track <= tracks * bands; track += bands) {
        if(excluding != -track) {
            for(band = track; band < track + bands; band += 1) {
                if(excluding) {
                    of = peek(j_max, 0, band);	// Don't normalize if it's determining the universal `mode_interval`. 
                    if(!of) {                   //Empty space on a track shouldn't count towards the average. 
                        quantity -= 1;
                    }
                }
                vibe = peek(j_rhythm, frame, band);
                if(excluding > 0) {                             //Only log for jamming so it doesn't constantly get overwritten. 
                    normalized = vibe / of;
                    poke(log_j_scores, of, 0, band);
                    //blog(j_checks_log, normalized);
                }
                mean += vibe / of;
            }
        }
    }
    /*if(excluding) {
        blog(j_scores_log, mean);
        blog(j_scores_log, quantity);
    }*/
    mean /= quantity - (excluding != 0);   // ((tracks * 2) - (excluding != 0)) * bands;
    if(excluding) {
        blog(j_scores_log, mean);
        if(mean > 9) {
            blog(r_scores_log, mean);
            for(i = 0; i <= 8; i += 1) {
                blog(r_checks_log, peek(log_r_scores, 0, i));
                blog(j_checks_log, peek(log_j_scores, 0, i));
            }
        }
    }
    return mean;
}