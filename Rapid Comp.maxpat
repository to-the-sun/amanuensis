													"code" : "Buffer palette(\"_p\");\r\nBuffer product(\"sequence1\");\r\nBuffer undo(\"undo\");\r\nBuffer low(\"low\");\r\nBuffer high(\"high\");\r\nBuffer stats(\"stats\");\r\nBuffer undo_track(\"undo_track\");\r\nParam track(1);\r\nParam iterations(99);\r\nParam to(0);\r\nParam from(0);\r\nParam offset(0);\r\nHistory at(0);\r\nHistory through(0);\r\nfinished = 0;\r\nif(change(in1) > 0) {\r\n\tat = from;\r\n\tthrough = to + (45 * 4999);\t\t//max fade time in dynamic_crossfade\r\n}\r\nif(at < through) {\r\n    for(i = at; i < at + iterations; i += 1) {\r\n\t\told = peek(product, i);\r\n    \tpoke(undo, old, i, track);\r\n    }\r\n\tat += iterations;\r\n}\r\nelse {\r\n\tfinished = 1;\r\n}\r\nout1 = finished;\r\nout2 = track;\r\nout3 = peek(undo_track, 0);",
													"fontface" : 0,
													"fontname" : "<Monospaced>",
													"fontsize" : 10.0,
													"id" : "obj-3",
